import { ComboBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    width: 100px;
    height: 100px;
    background: transparent;
    ComboBox {
        x: 5px;
        y: 5px;
        width: 200px;
        model: ["first", "second", "third"];
        current-value: "first";
    }
}

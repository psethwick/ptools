{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-typescript-and-sass",
            "detail": "Runs Typescript and Sass compilers.",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "build-typescript",
                "build-sass"
            ],
            "dependsOrder": "parallel"
        },
        {
            "label": "build-typescript",
            "type": "shell",
            "command": "echo 'Building TypeScript...' && sleep 3"
        },
        {
            "label": "build-sass",
            "type": "shell",
            "command": "echo 'Building Sass...' && sleep 2"
        },
        {
            "label": "cwd-test",
            "type": "shell",
            "command": "echo `pwd`",
            "options": {
                "cwd": "/home"
            }
        },
        {
            "label": "cwd-workspace-folder",
            "type": "shell",
            "command": "echo `pwd`",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "input-test",
            "type": "shell",
            "command": "echo ${input:revision_msg}"
        },
    ],
    "inputs": [
        {
            "type": "prompt",
            "id": "revision_msg",
            "prompt": "WHAT IS YOUR MAJOR MALFUNCTION"
        }
    ]
}
